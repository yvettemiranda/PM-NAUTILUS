# New independent HTTPS virtual host; replace domain/certificate paths locally.
server {
    listen 443 ssl;
    server_name pm.example.com;
    ssl_certificate /etc/letsencrypt/live/pm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pm.example.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 60s;
    }
    # A large ledger snapshot may take several minutes before download starts.
    location = /api/live/wallet/backup {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }
    # The encrypted LIVE migration bundle can be larger than Nginx's default
    # upload limit. Keep this allowance scoped to the restore endpoint.
    location = /api/live/wallet/restore {
        client_max_body_size 2100m;
        client_body_timeout 1800s;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
    }
}
server {
    listen 80;
    server_name pm.example.com;
    return 301 https://$host$request_uri;
}
