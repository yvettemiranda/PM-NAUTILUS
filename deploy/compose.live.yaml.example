# Opt-in example only. Copy to repository root as compose.live.yaml ONLY after
# explicit LIVE authorization, actual wallet preflight and credential setup.
services:
  app:
    environment:
      PM_LIVE_ENABLED: "true"
      PM_LIVE_CREDENTIALS_FILE: /run/secrets/live.json
    volumes:
      - ./runtime/secrets/live.json:/run/secrets/live.json:ro
