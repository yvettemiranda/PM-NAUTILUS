# Copy locally to .env; never commit credentials. Deployment stays TEST + PAUSED.
PM_UI_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
PM_ALLOWED_HOSTS=localhost,127.0.0.1
PM_PORT=8765
PM_GIT_REVISION=REPLACE_WITH_GIT_REV_PARSE_HEAD
PM_LIVE_ENABLED=false
# TEST uses account 1. An existing PM_TEST_ACTIVE_ACCOUNT=1 is accepted for rollback.
# Set true only behind a trusted HTTPS reverse proxy that overwrites X-Forwarded-Proto.
PM_TRUST_HTTPS_PROXY=false
# The web LIVE wallet stays locked on every process restart.
# Record the TEST 1 feed to the separate Docker volume while TEST is running.
PM_TEST_CAPTURE_ENABLED=true
PM_TEST_CAPTURE_MAX_GIB=4
# Reserve at least this much free space and at least 20% of the filesystem.
PM_TEST_CAPTURE_RESERVE_GIB=12
