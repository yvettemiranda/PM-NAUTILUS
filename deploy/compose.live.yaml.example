# Opt-in example only. After manual unlock, copy to the repository root as
# compose.live.yaml for configuration checks and the one-off private preflight.
# Do not use it with `up` for the persistent app until preflight passes and the
# user explicitly chooses to enter the LIVE context.
# Combine it after compose.yaml and any local compose.override.yaml in use.
services:
  app:
    environment:
      PM_LIVE_ENABLED: "true"
      PM_LIVE_CREDENTIALS_FILE: /run/secrets/live.json
    volumes:
      - type: bind
        source: /run/pm-nautilus/live.json
        target: /run/secrets/live.json
        read_only: true
        bind:
          create_host_path: false
